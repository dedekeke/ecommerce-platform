# E-Commerce Platform Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# Auth0 Configuration
# ============================================
# Your Auth0 tenant domain (e.g., dev-abc123.us.auth0.com)
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Your Auth0 issuer URI (must include trailing slash!)
# Format: https://{AUTH0_DOMAIN}/
AUTH0_ISSUER_URI=https://your-tenant.us.auth0.com/

# Your API identifier (audience)
# This is defined when you create an API in Auth0 Dashboard
AUTH0_AUDIENCE=https://ecommerce-api.example.com

# Your Auth0 Application Client ID (for SPA)
AUTH0_CLIENT_ID=your_client_id_here

# Your Auth0 Application Client Secret (for M2M)
# Note: Only needed for machine-to-machine authentication
AUTH0_CLIENT_SECRET=your_client_secret_here

# ============================================
# Database Configuration (Optional - uses defaults in docker-compose)
# ============================================
# POSTGRES_USER=admin
# POSTGRES_PASSWORD=admin123
# MYSQL_USER=admin
# MYSQL_PASSWORD=admin123
# MONGODB_USER=admin
# MONGODB_PASSWORD=admin123

# ============================================
# Application Configuration
# ============================================
# Spring profiles (default: docker when running in containers)
# SPRING_PROFILES_ACTIVE=docker

# ============================================
# Mail / SMTP (Local dev uses MailHog)
# ============================================
# Local dev: point at the MailHog container started by docker-compose
#   docker-compose up -d mailhog
#   SMTP at localhost:1025, Web UI at http://localhost:8025
# Production: replace with real SMTP host/port and credentials.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_FROM=noreply@ecommerce.local
EMAIL_FROM_NAME=E-Commerce Platform

# ============================================
# Deployment / Infrastructure (Helm + k8s)
# ============================================
# Container registry for built images. Default ghcr.io/<org>; rendered into helm
# global.imageRegistry and the kustomize overlay image transformers (envsubst/CI).
IMAGE_REGISTRY=ghcr.io/ecommerce-platform

# Public base domain for ingress + TLS. Never hardcode a real domain in manifests.
# Rendered into the ingress host and the cert-manager Certificate via envsubst / --set.
BASE_DOMAIN=shop.example.test

# ACME contact e-mail for the cert-manager Let's Encrypt ClusterIssuer.
ACME_EMAIL=ops@example.test

# Disaster recovery — Elasticsearch S3 snapshot repository.
ES_SNAPSHOT_BUCKET=ecommerce-dr
AWS_S3_REGION=us-east-1

# Disaster recovery — Kafka MirrorMaker 2.0 source/target bootstrap endpoints.
KAFKA_SOURCE_BOOTSTRAP=kafka:9092
KAFKA_DR_BOOTSTRAP=kafka-dr.dr-region:9092

# ============================================
# How to Get Auth0 Values:
# ============================================
# 1. Go to https://manage.auth0.com/
# 2. Navigate to Applications → Applications
# 3. Select or create your application
# 4. Copy the Domain, Client ID, and Client Secret
# 5. Navigate to Applications → APIs
# 6. Create an API or select existing one
# 7. Copy the API Identifier (this is your AUDIENCE)
