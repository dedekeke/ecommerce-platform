-- Default partition catches any rows that fall outside the 12-month window —
-- protects against application clock skew. Roll new partitions BEFORE
-- letting rows land here; default partitions cannot be efficiently pruned.
CREATE TABLE orders_p_default PARTITION OF orders_partitioned DEFAULT;
