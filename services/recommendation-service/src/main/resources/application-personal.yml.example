# Local development overrides for recommendation-service.
# Copy to application-personal.yml and activate with --spring.profiles.active=personal
# (application-personal.yml is git-ignored).
spring:
  data:
    mongodb:
      uri: mongodb://localhost:27017/recommendation_db

  kafka:
    bootstrap-servers: localhost:9092

eureka:
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka/

security:
  enabled: false

auth0:
  domain: your-tenant.auth0.com
  audience: https://api.ecommerce.local
