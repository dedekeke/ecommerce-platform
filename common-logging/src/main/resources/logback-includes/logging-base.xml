<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared logging configuration for all e-commerce platform services.
  SINGLE SOURCE OF TRUTH - this file lives ONLY in the `common-logging` module.
  Every service/infra module gets it on the classpath by depending on `common-logging`
  (no per-module mirrored copies). Do not fork the appender definitions.

  Each module includes this from its own src/main/resources/logback-spring.xml:

      <configuration>
          <include resource="logback-includes/logging-base.xml"/>
      </configuration>

  Profiles:
    * default / local / dev        -> human-readable colored CONSOLE (local dev unchanged)
    * docker / prod / json-logging -> single-line JSON to stdout (scraped by Promtail -> Loki)

  Trace correlation: traceId / spanId come from the Micrometer Tracing Brave bridge
  MDC (io.zipkin.brave:brave-context-slf4j), present on every service classpath.
  correlationId / requestId / userId are emitted only when an application filter
  populates them.
-->
<included>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="application"/>

    <!-- Human-readable console for local development -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{36}) - [traceId=%X{traceId:-} spanId=%X{spanId:-} correlationId=%X{correlationId:-}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Structured JSON to stdout for log aggregation (Loki via Promtail) -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>spanId</includeMdcKeyName>
            <includeMdcKeyName>correlationId</includeMdcKeyName>
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <!-- "service" label drives Loki stream selection; keep the name stable -->
            <customFields>{"service":"${appName}"}</customFields>
            <!-- @timestamp matches the Promtail pipeline's timestamp source (monitoring/promtail) -->
            <fieldNames>
                <timestamp>@timestamp</timestamp>
                <message>message</message>
                <logger>logger</logger>
                <thread>thread</thread>
                <level>level</level>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
        </encoder>
    </appender>

    <springProfile name="docker | prod | json-logging">
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
        <logger name="com.ecommerce" level="INFO"/>
        <logger name="org.springframework" level="WARN"/>
    </springProfile>

    <springProfile name="!docker &amp; !prod &amp; !json-logging">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.ecommerce" level="DEBUG"/>
    </springProfile>

    <!-- Library noise reduction (all profiles) -->
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.mongodb.driver" level="WARN"/>
    <logger name="io.grpc" level="WARN"/>
    <logger name="brave" level="WARN"/>
    <logger name="zipkin2" level="WARN"/>

</included>
