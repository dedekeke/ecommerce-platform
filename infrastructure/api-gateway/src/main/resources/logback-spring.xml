<?xml version="1.0" encoding="UTF-8"?>
<!--
  Gateway logging config. Delegates to the shared base on the classpath
  (logback-includes/logging-base.xml), provided by the `common-logging` module.
  Logback initialises before the (WebFlux) web context, so this loads independently
  of the reactive stack. Do not copy the base in here - it lives in exactly one place.
-->
<configuration>
    <include resource="logback-includes/logging-base.xml"/>
</configuration>
