# Runtime-only Dockerfile for API Gateway
# Prerequisite: Build the JAR first with: mvn clean package -pl infrastructure/api-gateway -DskipTests
#
# NOTE: docker-compose.yml no longer uses this file — the api-gateway service
# now builds from the standalone hermetic `Dockerfile` (aligned with
# eureka-server and config-server). This runtime variant is retained only for
# the manual fast-local path where a host JAR already exists. It pins the
# SNAPSHOT JAR name below, so it must be updated on every version bump.

FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

# Create non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup && \
    mkdir -p /app && chown -R appuser:appgroup /app

# Copy pre-built JAR
COPY infrastructure/api-gateway/target/api-gateway-1.0.0-SNAPSHOT.jar app.jar

# Change ownership
RUN chown -R appuser:appgroup /app

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
  CMD wget --spider --quiet http://localhost:8080/actuator/health || exit 1

# JVM options
ENV JAVA_OPTS="-Xmx512m -Xms256m -XX:+UseG1GC"

# Run the application
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
