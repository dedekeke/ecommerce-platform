<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWASP Dependency-Check suppression file.

  Add a <suppress> block ONLY for a false positive or an accepted risk, and
  always justify it with <notes> (CVE id, reason, owner, review date). Prefer
  upgrading the vulnerable dependency over suppressing it.

  Reference: https://jeremylong.github.io/DependencyCheck/general/suppression.html

  Example (kept commented — do not suppress without justification):

  <suppress>
    <notes><![CDATA[
      False positive: CVE applies to the standalone CLI, not the embedded
      library we use. Reviewed 2026-06-14 by platform-security.
    ]]></notes>
    <packageUrl regex="true">^pkg:maven/com\.example/some-lib@.*$</packageUrl>
    <cve>CVE-0000-00000</cve>
  </suppress>
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
</suppressions>
