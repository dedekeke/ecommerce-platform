# Checkout MFE environment configuration (copy to .env.local; never commit real values)

# API gateway base URL
VITE_API_BASE_URL=http://localhost:8080/api

# Stripe publishable key (pk_...). Required for the checkout payment step — Stripe Elements is
# the only supported payment flow (PCI SAQ-A: this app never collects raw card data).
# This is a publishable (client-side) key, not the secret key. Use a Stripe test key (pk_test_...)
# for local/dev. Do not commit a real value.
VITE_STRIPE_PUBLISHABLE_KEY=
