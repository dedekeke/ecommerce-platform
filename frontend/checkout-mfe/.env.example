# Checkout MFE environment configuration (copy to .env.local; never commit real values)

# API gateway base URL
VITE_API_BASE_URL=http://localhost:8080/api

# Payment provider: 'mock' (default, legacy card form) or 'stripe' (real Stripe.js confirmation)
VITE_PAYMENTS_PROVIDER=mock

# Stripe publishable key (pk_...). Required only when VITE_PAYMENTS_PROVIDER=stripe.
# This is a publishable (client-side) key, not the secret key. Do not commit a real value.
VITE_STRIPE_PUBLISHABLE_KEY=
