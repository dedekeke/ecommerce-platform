# Frontend Environment Variables
# Copy this file to .env.local and fill in your actual values

# API Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Auth0 Configuration
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your_client_id
VITE_AUTH0_AUDIENCE=https://api.ecommerce-platform.com
VITE_AUTH0_REDIRECT_URI=http://localhost:5173

# Local test auth mode (e2e only). Dev-server only: production builds fail with
# MOCK_AUTH_PRODUCTION_GUARD if set. See src/auth/mockAuth.ts and e2e/README.md.
# VITE_AUTH_MODE=mock
