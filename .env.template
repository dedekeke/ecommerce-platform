# E-Commerce Platform - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# Auth0 Configuration
# ============================================
# Get these from your Auth0 dashboard: https://manage.auth0.com
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_ISSUER_URI=https://your-tenant.auth0.com/
AUTH0_CLIENT_ID=your_client_id
AUTH0_CLIENT_SECRET=your_client_secret
AUTH0_AUDIENCE=https://api.ecommerce-platform.com
AUTH0_M2M_CLIENT_ID=your_m2m_client_id
AUTH0_M2M_CLIENT_SECRET=your_m2m_client_secret

# ============================================
# Database Configuration
# ============================================
# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=ecommerce

# Shared DB connection ceilings (REQUIRED by docker-compose.yml / .prod.yml).
# Must be >= sum of co-tenant Hikari pools at max replicas + ~10 admin reserve.
# See docs/db-connection-budget.md.
POSTGRES_MAX_CONNECTIONS=200
MYSQL_MAX_CONNECTIONS=150

# Hikari pool overrides (OPTIONAL; defaults live per-service in application.yml).
# DB_POOL_SIZE=5
# DB_POOL_MIN_IDLE=2

# Database URLs (used by services)
USER_DB_URL=jdbc:postgresql://localhost:5432/userdb
PRODUCT_DB_URL=jdbc:postgresql://localhost:5432/productdb
ORDER_DB_URL=jdbc:postgresql://localhost:5432/orderdb
PAYMENT_DB_URL=jdbc:postgresql://localhost:5432/paymentdb
INVENTORY_DB_URL=jdbc:postgresql://localhost:5432/inventorydb
PROMOTION_DB_URL=jdbc:postgresql://localhost:5432/promotiondb

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin123
MONGO_URI=mongodb://admin:admin123@localhost:27017

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# Kafka Configuration
# ============================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=ecommerce-platform

# ============================================
# Elasticsearch Configuration
# ============================================
ELASTICSEARCH_URIS=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ============================================
# Service Discovery (Eureka)
# ============================================
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# ============================================
# Config Server
# ============================================
CONFIG_SERVER_URL=http://localhost:8888
CONFIG_SERVER_GIT_URI=https://github.com/your-org/config-repo.git
CONFIG_SERVER_GIT_USERNAME=
CONFIG_SERVER_GIT_PASSWORD=

# ============================================
# Observability
# ============================================
# Zipkin
ZIPKIN_BASE_URL=http://localhost:9411
# Distributed-trace sampling rate for the dev/default profile (1.0 = 100%).
# Consumed by every service's base application.yml as
# management.tracing.sampling.probability=${TRACING_SAMPLING_PROBABILITY:1.0}.
TRACING_SAMPLING_PROBABILITY=1.0
# Prod profile lowers sampling to protect the single Zipkin + single-node ES
# backend; retune via TRACING_SAMPLING_PROBABILITY_PROD (see production.env.example).
TRACING_SAMPLING_PROBABILITY_PROD=0.1

# Prometheus
PROMETHEUS_URL=http://localhost:9090

# Grafana
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ============================================
# API Gateway
# ============================================
GATEWAY_PORT=8080
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Global outbound response timeout (gateway -> downstream). Duration string.
GATEWAY_RESPONSE_TIMEOUT=5s
# Per-route override for payment routes (3rd-party PSPs). Milliseconds.
GATEWAY_PAYMENT_RESPONSE_TIMEOUT=10000
# Route authority: declarative application.yml routes are the single source of
# truth. Keep false; the programmatic RouteLocator is an opt-in fallback only.
GATEWAY_PROGRAMMATIC_ROUTES_ENABLED=false

# ============================================
# External Services (Mocks for Development)
# ============================================
# Payment Gateway (Stripe/Mock)
PAYMENT_GATEWAY_API_KEY=your_payment_gateway_api_key
PAYMENT_GATEWAY_SECRET=your_payment_gateway_secret

# Email Service (SendGrid/SES) — production-only
EMAIL_SERVICE_API_KEY=your_email_service_api_key
EMAIL_FROM_ADDRESS=noreply@ecommerce-platform.com
EMAIL_FROM_NAME=E-Commerce Platform

# Local SMTP via MailHog (docker-compose service "mailhog")
# Override MAIL_HOST=mailhog when notification-service runs inside docker;
# use MAIL_HOST=localhost when running it on the host.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_FROM=noreply@ecommerce.local

# SMS Service (Twilio)
SMS_SERVICE_ACCOUNT_SID=your_twilio_account_sid
SMS_SERVICE_AUTH_TOKEN=your_twilio_auth_token
SMS_SERVICE_PHONE_NUMBER=+1234567890

# ============================================
# File Storage
# ============================================
# Use 'local' for development, 's3' for production
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/storage

# AWS S3 (if using S3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=ecommerce-media
AWS_S3_REGION=us-east-1

# ============================================
# Application Configuration
# ============================================
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=INFO

# JWT Configuration
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_SECOND=10
RATE_LIMIT_BURST_CAPACITY=20

# ============================================
# Deployment / Infrastructure (Helm + k8s)
# ============================================
# Container registry for built images (helm global.imageRegistry + kustomize overlays).
IMAGE_REGISTRY=ghcr.io/ecommerce-platform
# Public base domain for ingress + TLS (never hardcode a real domain in manifests).
BASE_DOMAIN=shop.example.test
# ACME contact e-mail for the cert-manager Let's Encrypt ClusterIssuer.
ACME_EMAIL=ops@example.test
# DR — Elasticsearch S3 snapshot bucket (region reuses AWS_S3_REGION above).
ES_SNAPSHOT_BUCKET=ecommerce-dr
# DR — Kafka MirrorMaker 2.0 source/target bootstrap endpoints.
KAFKA_SOURCE_BOOTSTRAP=kafka:9092
KAFKA_DR_BOOTSTRAP=kafka-dr.dr-region:9092

# ============================================
# Frontend Configuration
# ============================================
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_AUTH0_DOMAIN=${AUTH0_DOMAIN}
VITE_AUTH0_CLIENT_ID=${AUTH0_CLIENT_ID}
VITE_AUTH0_AUDIENCE=${AUTH0_AUDIENCE}

# ============================================
# Development Tools
# ============================================
# Enable/Disable features for development
FEATURE_FLAG_ADMIN_PANEL=true
FEATURE_FLAG_ANALYTICS=true
FEATURE_FLAG_RECOMMENDATIONS=false

# Debug Mode
DEBUG_MODE=false

# ============================================
# Currency Rate Refresh (promotion-service, §3.5)
# ============================================
# External FX-rate API endpoint. Expected shape:
#   { "base": "USD", "rates": { "EUR": 0.92, "GBP": 0.79, ... } }
# Leave blank to keep the deterministic Flyway-seeded rates.
CURRENCY_RATE_API_URL=
# Spring cron (6-field) for the refresh job. Default: top of every hour.
CURRENCY_RATE_REFRESH_CRON=0 0 * * * *
# Gates the scheduled currency rate refresh job. OFF by default.
FEATURE_FLAG_CURRENCY_RATE_REFRESH=false

# ============================================
# Search Index Maintenance (search-service)
# ============================================
# Gates the one-shot admin brand/rating ES backfill endpoint
# (POST /api/admin/search/backfill/brand-rating). OFF by default;
# flip on only while running the backfill, then flip back.
FEATURE_FLAG_ES_BACKFILL=false

# ============================================
# Inter-service HTTP timeouts (milliseconds)
# ============================================
# user-service lookup (promotion-service RestClient + cart-service Feign)
USER_SERVICE_CONNECT_TIMEOUT_MS=2000
USER_SERVICE_READ_TIMEOUT_MS=3000
# currency FX-rate provider (promotion-service HttpCurrencyRateProvider)
CURRENCY_RATE_CONNECT_TIMEOUT_MS=2000
CURRENCY_RATE_READ_TIMEOUT_MS=5000
# cart-service Feign default (applies to all named clients lacking an override)
FEIGN_DEFAULT_CONNECT_TIMEOUT_MS=2000
FEIGN_DEFAULT_READ_TIMEOUT_MS=5000

# ============================================
# Payment Service — Stripe
# ============================================
# Provider: 'mock' (default) or 'stripe'.
PAYMENT_PROVIDER=mock
# Stripe secret API key (sk_test_ in test mode). Never commit a real key.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Optional Stripe API base override; blank uses the live API.
STRIPE_API_BASE=
# Webhook signing secret (whsec_) verifying POST /api/payments/webhook. Never commit a real value.
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# ============================================
# Security
# ============================================
# Encryption key for sensitive data
ENCRYPTION_KEY=your_32_character_encryption_key_here

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_MAX_AGE=3600
