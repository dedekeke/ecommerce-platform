# E-Commerce Platform - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# Auth0 Configuration
# ============================================
# Get these from your Auth0 dashboard: https://manage.auth0.com
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_ISSUER_URI=https://your-tenant.auth0.com/
AUTH0_CLIENT_ID=your_client_id
AUTH0_CLIENT_SECRET=your_client_secret
AUTH0_AUDIENCE=https://api.ecommerce-platform.com
AUTH0_M2M_CLIENT_ID=your_m2m_client_id
AUTH0_M2M_CLIENT_SECRET=your_m2m_client_secret

# ============================================
# Database Configuration
# ============================================
# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=ecommerce

# Database URLs (used by services)
USER_DB_URL=jdbc:postgresql://localhost:5432/userdb
PRODUCT_DB_URL=jdbc:postgresql://localhost:5432/productdb
ORDER_DB_URL=jdbc:postgresql://localhost:5432/orderdb
PAYMENT_DB_URL=jdbc:postgresql://localhost:5432/paymentdb
INVENTORY_DB_URL=jdbc:postgresql://localhost:5432/inventorydb
PROMOTION_DB_URL=jdbc:postgresql://localhost:5432/promotiondb

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin123
MONGO_URI=mongodb://admin:admin123@localhost:27017

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# Kafka Configuration
# ============================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=ecommerce-platform

# ============================================
# Elasticsearch Configuration
# ============================================
ELASTICSEARCH_URIS=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ============================================
# Service Discovery (Eureka)
# ============================================
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# ============================================
# Config Server
# ============================================
CONFIG_SERVER_URL=http://localhost:8888
CONFIG_SERVER_GIT_URI=https://github.com/your-org/config-repo.git
CONFIG_SERVER_GIT_USERNAME=
CONFIG_SERVER_GIT_PASSWORD=

# ============================================
# Observability
# ============================================
# Zipkin
ZIPKIN_BASE_URL=http://localhost:9411
TRACING_SAMPLING_PROBABILITY=1.0

# Prometheus
PROMETHEUS_URL=http://localhost:9090

# Grafana
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ============================================
# API Gateway
# ============================================
GATEWAY_PORT=8080
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# External Services (Mocks for Development)
# ============================================
# Payment Gateway (Stripe/Mock)
PAYMENT_GATEWAY_API_KEY=your_payment_gateway_api_key
PAYMENT_GATEWAY_SECRET=your_payment_gateway_secret

# Email Service (SendGrid/SES) — production-only
EMAIL_SERVICE_API_KEY=your_email_service_api_key
EMAIL_FROM_ADDRESS=noreply@ecommerce-platform.com
EMAIL_FROM_NAME=E-Commerce Platform

# Local SMTP via MailHog (docker-compose service "mailhog")
# Override MAIL_HOST=mailhog when notification-service runs inside docker;
# use MAIL_HOST=localhost when running it on the host.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_FROM=noreply@ecommerce.local

# SMS Service (Twilio)
SMS_SERVICE_ACCOUNT_SID=your_twilio_account_sid
SMS_SERVICE_AUTH_TOKEN=your_twilio_auth_token
SMS_SERVICE_PHONE_NUMBER=+1234567890

# ============================================
# File Storage
# ============================================
# Use 'local' for development, 's3' for production
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/storage

# AWS S3 (if using S3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=ecommerce-media
AWS_S3_REGION=us-east-1

# ============================================
# Application Configuration
# ============================================
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=INFO

# JWT Configuration
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_SECOND=10
RATE_LIMIT_BURST_CAPACITY=20

# ============================================
# Deployment / Infrastructure (Helm + k8s)
# ============================================
# Container registry for built images (helm global.imageRegistry + kustomize overlays).
IMAGE_REGISTRY=ghcr.io/ecommerce-platform
# Public base domain for ingress + TLS (never hardcode a real domain in manifests).
BASE_DOMAIN=shop.example.test
# ACME contact e-mail for the cert-manager Let's Encrypt ClusterIssuer.
ACME_EMAIL=ops@example.test
# DR — Elasticsearch S3 snapshot bucket (region reuses AWS_S3_REGION above).
ES_SNAPSHOT_BUCKET=ecommerce-dr
# DR — Kafka MirrorMaker 2.0 source/target bootstrap endpoints.
KAFKA_SOURCE_BOOTSTRAP=kafka:9092
KAFKA_DR_BOOTSTRAP=kafka-dr.dr-region:9092

# ============================================
# Frontend Configuration
# ============================================
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_AUTH0_DOMAIN=${AUTH0_DOMAIN}
VITE_AUTH0_CLIENT_ID=${AUTH0_CLIENT_ID}
VITE_AUTH0_AUDIENCE=${AUTH0_AUDIENCE}

# ============================================
# Development Tools
# ============================================
# Enable/Disable features for development
FEATURE_FLAG_ADMIN_PANEL=true
FEATURE_FLAG_ANALYTICS=true
FEATURE_FLAG_RECOMMENDATIONS=false

# Debug Mode
DEBUG_MODE=false

# ============================================
# Security
# ============================================
# Encryption key for sensitive data
ENCRYPTION_KEY=your_32_character_encryption_key_here

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_MAX_AGE=3600
