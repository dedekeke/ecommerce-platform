{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "SLOs / Error Budgets",
  "uid": "slos-error-budgets",
  "schemaVersion": 39,
  "tags": ["slo", "reliability"],
  "time": { "from": "now-30d", "to": "now" },
  "timezone": "browser",
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Error budget remaining (30d window)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "api-gateway",
      "id": 1,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - ((sum(rate(http_server_requests_seconds_count{application=\"api-gateway\",outcome!=\"SUCCESS\"}[30d])) / sum(rate(http_server_requests_seconds_count{application=\"api-gateway\"}[30d]))) / 0.001)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.25 },
              { "color": "green", "value": 0.5 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" }
    },
    {
      "type": "stat",
      "title": "product-service",
      "id": 2,
