      "type": "table",
      "title": "Top services by error rate (last 24h)",
      "id": 31,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "topk(11, sum by (application) (rate(http_server_requests_seconds_count{application=~\"api-gateway|product-service|order-service|payment-service|cart-service|inventory-service|search-service|notification-service|promotion-service|user-service|media-service\",outcome!=\"SUCCESS\"}[24h])) / sum by (application) (rate(http_server_requests_seconds_count{application=~\"api-gateway|product-service|order-service|payment-service|cart-service|inventory-service|search-service|notification-service|promotion-service|user-service|media-service\"}[24h])))"
