# ==========================================================================
# production.env.example
# Copy to production.env (gitignored) and fill in real values BEFORE deploy.
# In real prod: source these from a secret manager (Vault / AWS Secrets / SOPS).
# ==========================================================================

# Image tag (must be an immutable SemVer; CI publishes images at this tag)
IMAGE_TAG=1.0.0

# Postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=ecommerce

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=

# Shared DB connection ceilings (REQUIRED — docker-compose.prod.yml has no :-defaults,
# so an unset value renders `max_connections=` and the DB container fails to start).
# Must be >= sum of co-tenant Hikari pools at max replicas + ~10 admin reserve.
# See docs/db-connection-budget.md.
POSTGRES_MAX_CONNECTIONS=200
MYSQL_MAX_CONNECTIONS=150

# Distributed-trace sampling in production (0.1 = 10%). Keep well below 1.0:
# full-rate spans overwhelm the single Zipkin collector + single-node
# Elasticsearch backend under load. Consumed by every application-prod.* as
# management.tracing.sampling.probability=${TRACING_SAMPLING_PROBABILITY_PROD:0.1}.
# See docs/TRACING_SETUP.md.
TRACING_SAMPLING_PROBABILITY_PROD=0.1

# Hikari pool overrides (OPTIONAL; defaults live per-service in application.yml).
# Set here to override ALL services in this compose file, or per-service via the
# service `environment:` block to tune one service.
# DB_POOL_SIZE=5
# DB_POOL_MIN_IDLE=2

# MongoDB
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# Redis
REDIS_PASSWORD=

# Elasticsearch
ELASTIC_PASSWORD=

# Spring datasource (PG)
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Auth0
AUTH0_DOMAIN=
AUTH0_ISSUER_URI=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# SMTP (notification-service)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Stripe (payment-service)
STRIPE_API_KEY=

# Object storage (media-service)
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Config server git source
CONFIG_GIT_URI=
CONFIG_GIT_USERNAME=
CONFIG_GIT_PASSWORD=
