# ==========================================================================
# production.env.example
# Copy to production.env (gitignored) and fill in real values BEFORE deploy.
# In real prod: source these from a secret manager (Vault / AWS Secrets / SOPS).
# ==========================================================================

# Image tag (must be an immutable SemVer; CI publishes images at this tag)
IMAGE_TAG=1.0.0

# Postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=ecommerce

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=

# MongoDB
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# Redis
REDIS_PASSWORD=

# Elasticsearch
ELASTIC_PASSWORD=

# Spring datasource (PG)
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Auth0
AUTH0_DOMAIN=
AUTH0_ISSUER_URI=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# SMTP (notification-service)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Stripe (payment-service)
STRIPE_API_KEY=

# Object storage (media-service)
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Config server git source
CONFIG_GIT_URI=
CONFIG_GIT_USERNAME=
CONFIG_GIT_PASSWORD=
